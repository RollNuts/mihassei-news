      "model_snapshot": {
        "id": "nagino-saya",
        "name": "凪野さや",
        "age": 27,
        "fictional": true,
        "appearance": "短い暗色のボブと軽い前髪。既存の顔と自然な成人の体型を維持し、髪を結ばない。",
        "master": {
          "path": "assets/generated/indoor-beach-friends-exchange-ripples.jpg",
          "sha256": "c3552d3b1fadefba52cfeec068c730c6da33de88f92b23dfd88edc9aabd9af94",
          "source_png_sha256": "17b054cc0006397c6408791d21fd53e2c7fc969b26e8dd37d706a9fee2408a95",
