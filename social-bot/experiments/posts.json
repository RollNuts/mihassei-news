{
  "schema_version": 1,
  "series": "x-impressions-experiments",
  "experiments": [
    {
      "id": "xexp-ghost-interview",
      "sequence": 1,
      "format": "surreal_text",
      "text": "本物の幽霊がお化け屋敷の面接に落ちた。\n理由は「怖がらせ方がわざとらしい」。",
      "mechanism": "inverted_expectation"
    },
    {
      "id": "xexp-future-advice",
      "sequence": 2,
      "format": "surreal_text",
      "text": "未来の自分が助言しに来た。\n「何をすればいい？」と聞くと、向こうも俺に聞きに来たらしい。",
      "mechanism": "self_reference"
    },
    {
      "id": "xexp-reaper-late",
      "sequence": 3,
      "format": "surreal_text",
      "text": "死神が初めて遅刻した。\n上司に「命に関わるぞ」と怒られた。",
      "mechanism": "literal_wordplay"
    },
    {
      "id": "xexp-ufo-ticket",
      "sequence": 4,
      "format": "surreal_text",
      "text": "UFOが駐車違反を取られた。\n宇宙人は「もうこの星には来ない」と言って、反則金だけ払った。",
      "hashtag": "#シュールネタ",
      "mechanism": "inverted_expectation",
      "visual": "ufo"
    },
    {
      "id": "xexp-robot-job",
      "sequence": 5,
      "format": "surreal_text",
      "text": "巨大ロボットが「目立たない仕事」に応募した。\n面接会場に入れなかった。",
      "mechanism": "physical_scale"
    },
    {
      "id": "xexp-fortune-spoiler",
      "sequence": 6,
      "format": "surreal_text",
      "text": "占い師の予言が当たりすぎて、店に「ネタバレ禁止」の張り紙が出た。",
      "hashtag": "#シュールネタ",
      "mechanism": "meta_commentary"
    },
    {
      "id": "xexp-underwater-office",
      "sequence": 7,
      "format": "surreal_text",
      "text": "海底の役所で「水に濡れた書類は受け付けません」と言われた。",
      "mechanism": "literal_wordplay"
    },
    {
      "id": "xexp-time-warranty",
      "sequence": 8,
      "format": "surreal_text",
      "text": "タイムマシンの保証書に「過去への返品は受け付けません」と書いてあった。",
      "hashtag": "#シュールネタ",
      "mechanism": "self_reference"
    },
    {
      "id": "xexp-dragon-candles",
      "sequence": 9,
      "format": "surreal_text",
      "text": "ドラゴンがキャンドル店を開いた。\n開店初日のレビューは「火力が強すぎる」。",
      "mechanism": "inverted_expectation"
    },
    {
      "id": "xexp-ghost-reunion",
      "sequence": 10,
      "format": "surreal_text",
      "text": "幽霊の同窓会、出席者全員が来ているのに、椅子だけ全部空いている。",
      "hashtag": "#シュールネタ",
      "mechanism": "visual_reveal"
    },
    {
      "id": "xexp-nejimachi-nothing-wrong",
      "sequence": 11,
      "format": "character_moment",
      "text": "ピトが「本日は問題ありません」と言った。\nネジはその報告を聞いて、初めて不安になった。",
      "hashtag": "#ネジまち",
      "mechanism": "dry_dialogue"
    },
    {
      "id": "xexp-nejimachi-one-screw",
      "sequence": 12,
      "format": "character_moment",
      "text": "ネジは街灯のネジを一本締めた。\n街は何も変わらなかったので、少し安心した。",
      "mechanism": "small_action"
    },
    {
      "id": "xexp-invisible-nails",
      "sequence": 13,
      "format": "surreal_text",
      "text": "透明人間がネイルサロンに行った。\n帰りの電車で、つり革をつかむ爪だけが宙に浮いていた。",
      "mechanism": "visual_reveal",
      "hashtag": "#シュールネタ",
      "featured": true,
      "visual": "nails"
    },
    {
      "id": "xexp-late-echo",
      "sequence": 14,
      "format": "surreal_text",
      "text": "山で「ヤッホー！」と叫んだら、こだまが「今日は無理」と返した。\n翌朝、「ホー！」だけ届いた。",
      "mechanism": "delayed_response",
      "featured": true
    },
    {
      "id": "xexp-alien-ocean",
      "sequence": 15,
      "format": "surreal_text",
      "text": "宇宙人が初めて海を見て、しばらく黙っていた。\n「地球、飲み物こぼしすぎじゃない？」",
      "mechanism": "perspective_flip",
      "hashtag": "#シュールネタ"
    },
    {
      "id": "xexp-shadow-home",
      "sequence": 16,
      "format": "surreal_text",
      "text": "影が本人より先に帰宅していた。\n玄関の明かりをつけたら、慌てて床に寝転んだ。",
      "mechanism": "visual_reveal",
      "visual": "shadow"
    },
    {
      "id": "xexp-witch-autopilot",
      "sequence": 17,
      "format": "surreal_text",
      "text": "魔女が空飛ぶほうきを自動運転にした。\n翌朝、ほうきだけ出勤して、魔女が家に残された。",
      "mechanism": "role_reversal",
      "hashtag": "#シュールネタ",
      "featured": true,
      "visual": "broom"
    },
    {
      "id": "xexp-planetarium-star",
      "sequence": 18,
      "format": "surreal_text",
      "text": "プラネタリウムの星が、本物の夜空を見に行った。\n感想は「思ったより暗い」。",
      "mechanism": "perspective_flip"
    },
    {
      "id": "xexp-scarecrow-dayoff",
      "sequence": 19,
      "format": "surreal_text",
      "text": "かかしが休みの日、カラスたちは畑の隅でおとなしく待っていた。\n「今日いないんだ」って。",
      "mechanism": "unexpected_kindness",
      "hashtag": "#シュールネタ"
    },
    {
      "id": "xexp-map-lost",
      "sequence": 20,
      "format": "surreal_text",
      "text": "地図が道に迷ったので、道路標識に現在地を聞いた。\n標識はずっと同じ方向を指していた。",
      "mechanism": "role_reversal"
    },
    {
      "id": "xexp-neji-lunch",
      "sequence": 21,
      "format": "character_moment",
      "text": "モクがネジに「昼休み何する？」と聞いた。\n「休む」\nモクは少し考えて「それ、いいね」と言った。",
      "mechanism": "dry_dialogue",
      "hashtag": "#ネジまち"
    },
    {
      "id": "xexp-pito-vending",
      "sequence": 22,
      "format": "character_moment",
      "text": "ピトが壊れた自販機に「調子はいかがですか」と聞いた。\n返事はなかったけど、ネジが温かい缶を一本置いていった。",
      "mechanism": "small_action"
    },
    {
      "id": "xexp-selfcheckout-dialogue",
      "sequence": 23,
      "format": "surreal_text",
      "text": "セルフレジに「店員をお呼びください」と言われた。店員には「セルフレジでお願いします」と言われた。二人とも丁寧なので、まだ会計が終わらない。",
      "mechanism": "dry_dialogue",
      "angle": "everyday_satire",
      "hashtag": "#シュールネタ"
    },
    {
      "id": "xexp-honest-survey",
      "sequence": 24,
      "format": "surreal_text",
      "text": "「率直なご意見を」と書かれたアンケート。自由記入欄は10文字まで。送信ボタンだけが、やけに大きい。",
      "mechanism": "meta_commentary",
      "angle": "everyday_satire",
      "featured": true
    },
    {
      "id": "xexp-waiting-zero",
      "sequence": 25,
      "format": "surreal_text",
      "text": "「待ち時間ゼロ」を売りにした新サービス。申し込み窓口の行列が、駅前まで伸びていた。",
      "mechanism": "inverted_expectation",
      "angle": "everyday_satire",
      "hashtag": "#シュールネタ"
    },
    {
      "id": "xexp-polite-notification",
      "sequence": 26,
      "format": "surreal_text",
      "text": "「スマホを見すぎないように」とスマホが通知してきた。朝から7回。8回目は「さっきの件、見ましたか？」だった。",
      "mechanism": "self_reference",
      "angle": "everyday_satire"
    },
    {
      "id": "xexp-lunch-price",
      "sequence": 27,
      "format": "surreal_text",
      "text": "弁当屋が「値上げしません」と宣言した。翌週、唐揚げは写真になった。容器だけは前より立派だった。",
      "mechanism": "visual_reveal",
      "angle": "everyday_satire",
      "hashtag": "#シュールネタ"
    },
    {
      "id": "xexp-paperless-announcement",
      "sequence": 28,
      "format": "surreal_text",
      "text": "ペーパーレスを始めたスーパー。「紙のレシートは出ません」というお知らせだけ、毎回紙で出てくる。",
      "mechanism": "literal_wordplay",
      "angle": "everyday_satire",
      "featured": true
    },
    {
      "id": "xexp-sock-career",
      "format": "surreal_text",
      "text": "洗濯機から消えた靴下が、三日後ネクタイを締めて帰ってきた。「片方だけでもやっていけるって、証明したかった」。残された片方が一番大きく拍手した。",
      "mechanism": "visual_reveal",
      "visual": "sock",
      "hashtag": "#シュールネタ",
      "featured": true,
      "sequence": 29
    },
    {
      "id": "xexp-book-review",
      "format": "surreal_text",
      "text": "図書館で借りた本が、私の読書感想文を書いていた。「毎晩3ページ目で寝る人です」。星は2つだった。返却期限だけは延ばしてくれた。",
      "mechanism": "role_reversal",
      "visual": "book",
      "hashtag": "#シュールネタ",
      "sequence": 30
    },
    {
      "id": "xexp-cloud-bus",
      "format": "surreal_text",
      "text": "雨雲がバス停で傘を差していた。「自分で降らせるんじゃないの？」と聞いたら、「今日は休みなんで」。バスが来る前に晴れた。",
      "mechanism": "perspective_flip",
      "visual": "cloud",
      "sequence": 31
    },
    {
      "id": "xexp-free-trial-farewell",
      "format": "surreal_text",
      "text": "無料体験を解約したら「本当にお別れですか」と聞かれた。次の画面では送別会が始まった。主賓なのに、退会ボタンはまだ見つからない。",
      "mechanism": "inverted_expectation",
      "angle": "everyday_satire",
      "sequence": 32
    },
    {
      "id": "xexp-fridge-egg-light",
      "format": "surreal_text",
      "text": "冷蔵庫の明かりが消える瞬間を見たくて、扉を少しだけ開けていた。中で卵がスマホのライトをつけていた。あっちもこっちを見ていた。",
      "mechanism": "visual_reveal",
      "sequence": 33
    },
    {
      "id": "xexp-door-shy",
      "format": "surreal_text",
      "text": "駅前の自動ドアが人見知りになった。人が来ると5センチだけ開いて、また閉じる。常連客だけが「今日も無理か」と横の手動ドアを使う。",
      "mechanism": "role_reversal",
      "hashtag": "#シュールネタ",
      "sequence": 34
    },
    {
      "id": "xexp-quiet-museum",
      "format": "surreal_text",
      "text": "『静かにお楽しみください』と書かれた美術館。注意のアナウンスが5分おきに流れる。最後に絵の中の犬が「うるさい」と吠えた。",
      "mechanism": "perspective_flip",
      "angle": "everyday_satire",
      "sequence": 35
    },
    {
      "id": "xexp-umbrella-return",
      "format": "surreal_text",
      "text": "雨の日に傘を借りて、晴れたら返そうと思った。貸出所には「雨の日だけ営業」と書いてあった。傘が少しずつ家族になっている。",
      "mechanism": "delayed_response",
      "hashtag": "#シュールネタ",
      "sequence": 36
    },
    {
      "id": "xexp-neji-doorbell",
      "format": "character_moment",
      "text": "ネジがきしむドアを直した。音が消えた翌朝、隣の家から「毎朝の挨拶が聞こえない」と言われた。ネジはネジを、ほんの少しだけ緩めた。",
      "mechanism": "unexpected_kindness",
      "sequence": 37
    },
    {
      "id": "xexp-moku-later-notes",
      "format": "character_moment",
      "text": "モクのポケットから「あとでやる」と書かれた紙が12枚出てきた。ネジが1枚に「いま読んだ」と書いて返すと、モクはそれを大切にしまった。",
      "mechanism": "dry_dialogue",
      "hashtag": "#ネジまち",
      "sequence": 38
    }
  ]
