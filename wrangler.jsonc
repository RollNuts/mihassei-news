{
  "name": "mihassei-news",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEWSROOM_STATS",
        "class_name": "NewsroomStats"
      },
      {
        "name": "READER_COMMENTS",
        "class_name": "ReaderComments"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NewsroomStats"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "ReaderComments"
      ]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "NEWSROOM_STATS",
          "class_name": "NewsroomStats"
        },
        {
          "name": "READER_COMMENTS",
          "class_name": "ReaderComments"
        }
      ]
    }
  }
}
